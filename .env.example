# Your public site URL (used in emails, sitemap and SEO tags)
NEXT_PUBLIC_SITE_URL=https://topaimate.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender. The domain must be verified in Resend (resend.com/domains).
# Until then you can use: TopAImate <onboarding@resend.dev> (only delivers to your own Resend account email).
RESEND_FROM=TopAImate <invites@topaimate.com>

# Who gets notified about new applications (comma-separated)
TEAM_EMAILS=invites@topaimate.com

# Created by `npm run resend:setup`
RESEND_SEGMENT_ID=
